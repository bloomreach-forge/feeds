<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--Override the default pageable factory-->
    <bean id="org.onehippo.cms7.essentials.components.ext.PageableFactory"
          class="org.onehippo.cms7.essentials.components.ext.DefaultPageableFactory"/>

  <!-- Default no-operation do before extension -->
  <bean id="org.onehippo.cms7.essentials.components.ext.DoBeforeRenderExtension"
        class="org.onehippo.cms7.essentials.components.ext.NoopDoBeforeRenderExtension"/>

  <!-- ============================================================ -->
  <!-- Feed Modifiers - Custom Extension Examples                   -->
  <!-- ============================================================ -->

  <!-- NOTE: Property-based filtering is now built-in to all feed types!
       Configure filters directly on the feed descriptor (RSS, Atom, Generic) using the
       "Filter by Property" and "Filter by Value" fields in the CMS UI.
       See PROPERTY_FILTERING_GUIDE.md for details.

       Atom feeds are automatically enriched with custom namespace fields (introduction, content,
       author, location, source, language, copyright). You can customize which fields to include.
       See ATOM_ENRICHMENT_GUIDE.md for details.
  -->

  <!-- Example 1: Custom Image modifier that adds image URLs to RSS items -->
  <bean id="imageModifier" class="org.example.feed.ImageModifier" scope="singleton"/>

  <!-- Example 2: Custom Atom enrichment with specific fields for your domain -->
  <!--
